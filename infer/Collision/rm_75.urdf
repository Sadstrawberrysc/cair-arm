  <!-- PREVIEW ONLY / 待实测核对：附件原点、轴向、绕轴角及实际包络尚未标定。
       Fixed chain: Link7 -> camera -> connector -> force_sensor -> Lprobe.
       Joint origins: mounting-frame placement (m, rad).
       Visual/collision origins: CAD datum alignment; STL millimetres -> metres.
       Geometry only: no invented mass/inertia, no TCP or camera optical calibration. -->

  <!-- camera: preview mounting and CAD datum; both require physical verification. -->
  <link name="camera_link">
    <visual>
      <origin xyz="-0.0285 0.0285 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <mesh filename="package://rm_description/meshes/rm_75_arm/camera.STL" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="camera_preview_material"><color rgba="0.75 0.85 1 1" /></material>
    </visual>
    <collision>
      <origin xyz="-0.0285 0.0285 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <mesh filename="package://rm_description/meshes/rm_75_arm/camera.STL" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <joint name="camera_mount" type="fixed">
    <parent link="Link7" />
    <child link="camera_link" />
    <!-- Direction corrected by user: -60 deg about Link7 +Z (right-hand rule). -->
    <origin xyz="0 0 0" rpy="0 0 -1.0471975511965976" />
  </joint>

  <!-- connector: preview mounting and CAD datum; both require physical verification. -->
  <link name="connector_link">
    <visual>
      <origin xyz="-0.030 0.030 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <mesh filename="package://rm_description/meshes/rm_75_arm/connector.STL" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="connector_preview_material"><color rgba="0.65 0.65 0.68 1" /></material>
    </visual>
    <collision>
      <origin xyz="-0.030 0.030 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <mesh filename="package://rm_description/meshes/rm_75_arm/connector.STL" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <joint name="connector_mount" type="fixed">
    <parent link="camera_link" />
    <child link="connector_link" />
    <!-- Cancel camera yaw so connector and sensor retain their Link7 orientation. -->
    <origin xyz="0 0 0.010" rpy="0 0 1.0471975511965976" />
  </joint>

  <!-- force_sensor: preview mounting and CAD datum; both require physical verification. -->
  <link name="force_sensor_link">
    <visual>
      <origin xyz="0 0 0.001" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rm_description/meshes/rm_75_arm/force_sensor.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="force_sensor_preview_material"><color rgba="0.35 0.38 0.42 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.001" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rm_description/meshes/rm_75_arm/force_sensor.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <joint name="force_sensor_mount" type="fixed">
    <parent link="connector_link" />
    <child link="force_sensor_link" />
    <origin xyz="0 0 0.010" rpy="0 0 0" />
  </joint>

  <!-- Lprobe: preview mounting and CAD datum; both require physical verification. -->
  <link name="Lprobe_link">
    <visual>
      <origin xyz="-0.03247935 0.0315 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <mesh filename="package://rm_description/meshes/rm_75_arm/Lprobe.STL" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="Lprobe_preview_material"><color rgba="0.95 0.95 0.90 1" /></material>
    </visual>
    <collision>
      <origin xyz="-0.03247935 0.0315 0" rpy="1.5707963267948966 0 0" />
      <geometry>
        <mesh filename="package://rm_description/meshes/rm_75_arm/Lprobe.STL" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <joint name="Lprobe_mount" type="fixed">
    <parent link="force_sensor_link" />
    <child link="Lprobe_link" />
    <!-- Direction corrected by user: final -30 deg about Link7 +Z, independent of camera yaw. -->
    <origin xyz="0 0 0.030" rpy="0 0 -0.5235987755982988" />
  </joint>

  <!-- User-specified coaxial support: 500 mm below base_link.
       base_link STL maximum radial extent is 54.9999 mm; support radius = 65 mm.
       Keep the controller Base frame unchanged; the cylinder top is at z=0. -->
  <link name="support_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.065" length="0.5" />
      </geometry>
      <material name="support_material"><color rgba="0.45 0.48 0.52 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.065" length="0.5" />
      </geometry>
    </collision>
  </link>
  <joint name="support_mount" type="fixed">
    <parent link="base_link" />
    <child link="support_link" />
    <origin xyz="0 0 -0.25" rpy="0 0 0" />
  </joint>
</robot>
